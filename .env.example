# Required: Claude API key (or sign in with `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Embeddings run locally by default (Transformers.js, nomic-embed-text-v1.5 on CPU). No key needed.
# To use hosted Voyage AI instead, set EMBEDDER=voyage and provide a key (https://www.voyageai.com/).
# EMBEDDER=local
# VOYAGE_API_KEY=

# Optional overrides
# PORT=8787          # API port
# API_PORT=8787      # where the Vite dev server proxies /api
# CLAUDE_MODEL=claude-opus-5-5
# CHAT_EFFORT=low     # low | medium | high; low keeps chat snappy
# RAG_DATA_DIR=./data           # where sources.json, raw/, index.sqlite live
# RAG_MODELS_DIR=./data/models  # embedding model cache; point several projects at one copy
# LOCAL_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
# LOCAL_EMBED_DTYPE=q8   # fp32 is slightly more accurate, four times the memory
# VOYAGE_MODEL=voyage-3.5
# CRAWL_CONCURRENCY=1
# CRAWL_DELAY_MS=2000
